<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SimpleSmaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Bento.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 界面字体 MiSans（可变字体，随安装包；没有时系统自动退回雅黑）。 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/MiSansVF.ttf#MiSans VF, Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
