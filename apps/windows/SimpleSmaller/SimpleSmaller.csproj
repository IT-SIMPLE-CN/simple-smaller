<Project Sdk="Microsoft.NET.Sdk">
  <!-- 简单小一点 Windows 版：WinUI 3，非打包（Velopack 安装与更新），自带 Windows App SDK 与 .NET 运行库。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SimpleSmaller</RootNamespace>
    <AssemblyName>SimpleSmaller</AssemblyName>
    <Platforms>ARM64;x64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 非打包应用也要生成 resources.pri 与 .xbf，否则 dotnet publish 的产物里没有，启动就找不到 Themes/Bento.xaml。 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 可空与命名类提示不影响使用，统一关掉。 -->
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8603;CS8604;CS8600;CS8601;CS8602;CS0108;CS1591</NoWarn>
    <!-- 不发布 AOT：[ObservableProperty] 用字段写法（可带初始值），关掉「建议改用分部属性」的提示。 -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <Product>简单小一点</Product>
    <!-- 对外版本号写在 apps/windows/version.txt（发版脚本与 Velopack 用同一个）。 -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../version.txt').Trim())</Version>
    <Company>IT-SIMPLE</Company>
    <Copyright>IT-SIMPLE · AGPLv3</Copyright>
    <!-- 入口在 Program.cs（单实例、以后的 Velopack 钩子），不用 XAML 生成的 Main。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- 测试打包（release-windows.ps1 -UpdateTest 传 -p:UpdateTest=true）：允许用 SMALLER_UPDATE_URL 指定更新源。
         不直接传 -p:DefineConstants，那样会整个覆盖上面这行。 -->
    <DefineConstants Condition="'$(UpdateTest)' == 'true'">$(DefineConstants);UPDATE_TEST</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <NativeArch Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(Platform)' == 'x64'">x64</NativeArch>
    <NativeArch Condition="'$(NativeArch)' == ''">arm64</NativeArch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 第三方许可证全文（AGPL 等要求随二进制附带）：仓库 licenses\common 加 Windows 专属的 licenses\windows，装到 Assets\ThirdParty。 -->
  <ItemGroup>
    <Content Include="..\..\..\licenses\common\*;..\..\..\licenses\windows\*" Link="Assets\ThirdParty\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 引擎是独立进程 smaller-core.exe（经标准输入输出通信，见 Core/EngineHost.cs），与 ffmpeg 一起由 scripts/build-core-windows.ps1 放到 Native\<架构>。 -->
  <ItemGroup>
    <None Include="Native\$(NativeArch)\smaller-core.exe" Link="smaller-core.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Native\$(NativeArch)\smaller-core.exe')" />
    <None Include="Native\$(NativeArch)\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Native\$(NativeArch)\ffmpeg.exe')" />
    <None Include="Native\$(NativeArch)\ffprobe.exe" Link="ffprobe.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Native\$(NativeArch)\ffprobe.exe')" />
  </ItemGroup>
</Project>
